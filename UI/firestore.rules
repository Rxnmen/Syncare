rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Disallow all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user documents
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null && request.auth.uid == userId
        // Strict whitelist of allowed fields
        && request.resource.data.keys().hasOnly([
          'fullName', 'age', 'city', 'waterTarget', 'stepsTarget', 'sleepTarget', 'email', 'completedMilestones', 'updatedAt'
        ])
        // Field validations
        && (!('fullName' in request.resource.data) || (
          request.resource.data.fullName is string &&
          request.resource.data.fullName.size() >= 1 &&
          request.resource.data.fullName.size() <= 100
        ))
        && (!('city' in request.resource.data) || (
          request.resource.data.city is string &&
          request.resource.data.city.size() >= 1 &&
          request.resource.data.city.size() <= 100
        ))
        && (!('age' in request.resource.data) || (
          request.resource.data.age is int &&
          request.resource.data.age >= 13 &&
          request.resource.data.age <= 100
        ))
        && (!('waterTarget' in request.resource.data) || (
          request.resource.data.waterTarget is int &&
          request.resource.data.waterTarget >= 500 &&
          request.resource.data.waterTarget <= 10000
        ))
        && (!('stepsTarget' in request.resource.data) || (
          request.resource.data.stepsTarget is int &&
          request.resource.data.stepsTarget >= 1000 &&
          request.resource.data.stepsTarget <= 100000
        ))
        && (!('sleepTarget' in request.resource.data) || (
          request.resource.data.sleepTarget is int &&
          request.resource.data.sleepTarget >= 3 &&
          request.resource.data.sleepTarget <= 14
        ))
        && (!('email' in request.resource.data) || (
          request.resource.data.email is string &&
          request.resource.data.email.size() <= 255
        ))
        && (!('completedMilestones' in request.resource.data) || (
          request.resource.data.completedMilestones is map
        ));
    }

    // Secure daily logs subcollection
    match /users/{userId}/daily_logs/{dateKey} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null && request.auth.uid == userId
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'date', 'water', 'steps', 'sleep', 'exercise', 'stress', 'study', 'mood', 'meals', 'precautions', 'updatedAt'
        ])
        && (!('date' in request.resource.data) || request.resource.data.date == dateKey)
        && (!('water' in request.resource.data) || (
          request.resource.data.water is number &&
          request.resource.data.water >= 0 &&
          request.resource.data.water <= 15000
        ))
        && (!('steps' in request.resource.data) || (
          request.resource.data.steps is number &&
          request.resource.data.steps >= 0 &&
          request.resource.data.steps <= 150000
        ))
        && (!('sleep' in request.resource.data) || (
          request.resource.data.sleep is number &&
          request.resource.data.sleep >= 0 &&
          request.resource.data.sleep <= 24
        ))
        && (!('exercise' in request.resource.data) || (
          request.resource.data.exercise is number &&
          request.resource.data.exercise >= 0 &&
          request.resource.data.exercise <= 720
        ))
        && (!('study' in request.resource.data) || (
          request.resource.data.study is number &&
          request.resource.data.study >= 0 &&
          request.resource.data.study <= 24
        ))
        && (!('stress' in request.resource.data) || (
          request.resource.data.stress in ['Low', 'Moderate', 'High']
        ))
        && (!('mood' in request.resource.data) || (
          request.resource.data.mood is string &&
          request.resource.data.mood.size() <= 50
        ))
        && (!('meals' in request.resource.data) || (
          request.resource.data.meals is list &&
          request.resource.data.meals.size() <= 20
        ))
        && (!('precautions' in request.resource.data) || (
          request.resource.data.precautions is list &&
          request.resource.data.precautions.size() <= 20
        ));
    }

    // Secure health records subcollection
    match /users/{userId}/health_records/{recordId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'date', 'status', 'updatedAt'
        ])
        && (!('id' in request.resource.data) || request.resource.data.id == recordId)
        && (!('name' in request.resource.data) || (
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 100
        ))
        && (!('date' in request.resource.data) || (
          request.resource.data.date is string &&
          request.resource.data.date.size() <= 50
        ))
        && (!('status' in request.resource.data) || (
          request.resource.data.status in ['Valid', 'Pending', 'Expired']
        ));
    }
  }
}
